{
  "name": "cv-martin-lamorgese",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CV web de Martín Lamorgese: HTML + PDF + Word generados desde data/*.json",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:fast": "node scripts/build.mjs --no-pdf",
    "serve": "node scripts/serve.mjs",
    "dev": "node scripts/build.mjs --no-pdf && node scripts/serve.mjs"
  },
  "dependencies": {
    "docx": "^9.0.0",
    "puppeteer": "^24.0.0"
  },
  "engines": { "node": ">=20" }
}
